# Macro: base_to_rebirth
# SENS_RECORDED_H:17.0
# SENS_RECORDED_V:17.0
# SENS_USER_H:17.0
# SENS_USER_V:17.0
# BLOCKLY_V1: 401d383b00d48622465f8bead0157f7130b795131ee54ef455c1383dacc6d39c 
VARIABLE:{"name":"closeButtonDifference","var_type":"number","value":0}
VARIABLE:{"name":"rebirthButtonDifference","var_type":"number","value":0}
VARIABLE:{"name":"extraDelayBetweenClicks","var_type":"number","value":0}
LOCK:
# @c:#006600 Settings // Everything in MS (1000ms = 1 sec)
SET_VARIABLE:{"name":"extraDelayBetweenClicks","value":{"lit":100}}
LOCK_END:
LOCK:
DELAY:200
# SECTION:Rebirth: Walk to NPC
SMOOTH_MOVE:-950,0
DELAY:100
KEY_DOWN:57
KEY_PRESS:10
DELAY:1000
SMOOTH_MOVE:-550,0
# SECTION_END
DELAY:550
# SECTION:Rebirth UI: Open
REPEAT:5
KEY_PRESS:45
DELAY:100
SET_VARIABLE:{"name":"closeButtonDifference","value":{"color_diff":{"a":{"lit":"rgba(247,255,26,255)"},"b":{"screen_color":{"x":386,"y":964}}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"closeButtonDifference"},"b":{"lit":0.25}}}}
BREAK_LOOP
END_IF
ENDREPEAT
KEY_UP:57
# SECTION_END
DELAY:500
# SECTION:Rebirth UI: Click
MOUSE_MOVE_ABS:941,938
DELAY:50
MOUSE_LEFT_CLICK
REPEAT:5
DELAY:100
SET_VARIABLE:{"name":"rebirthButtonDifference","value":{"color_diff":{"a":{"lit":"rgba(191,197,202,255)"},"b":{"screen_color":{"x":1425,"y":965}}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"rebirthButtonDifference"},"b":{"lit":0.05}}}}
BREAK_LOOP
END_IF
ENDREPEAT
DELAY:0
MOUSE_MOVE_ABS:1546,915
DELAY:50
MOUSE_LEFT_CLICK
# SECTION_END
DELAY:500
# SECTION:@c:#ff9900 Ensure Closed
SET_VARIABLE:{"name":"closeButtonDifference","value":{"color_diff":{"a":{"lit":"rgba(247,255,26,255)"},"b":{"screen_color":{"x":386,"y":964}}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"closeButtonDifference"},"b":{"lit":0.25}}}}
MOUSE_MOVE_ABS:386,964
DELAY:50
MOUSE_LEFT_CLICK
END_IF
# SECTION_END
LOCK_END:
