VARIABLE:{"name":"retry_a5","var_type":"number","value":0}
VARIABLE:{"name":"a5Poll","var_type":"number","value":0}
VARIABLE:{"name":"a5First","var_type":"number","value":0}
VARIABLE:{"name":"a5Hi","var_type":"number","value":0}
VARIABLE:{"name":"a5Lo","var_type":"number","value":0}
LOCK:
# @c:#006600 Settings // Everything in ms (1000 ms = 1 second)
SET_VARIABLE:{"name":"extraDelayBetweenClicks","value":{"lit":100}}
SET_VARIABLE:{"name":"extraDelayAfterMapLoads","value":{"lit":0}}
LOCK_END:
LOG:[base_to_meteor] START - gates: tp5 panel5 load5 tpb panelb loadb
LABEL:MACRO_START
LOCK:
DELAY:10
# SECTION:Walk: Area 6 Rift
KEY_PRESS:46
SMOOTH_MOVE:60,0
DELAY:10
KEY_DOWN:57
KEY_PRESS:10
DELAY:1000
KEY_PRESS:20
DELAY:400
KEY_PRESS:20
DELAY:400
KEY_PRESS:20
DELAY:330
KEY_PRESS:20
DELAY:500
KEY_UP:57
# SECTION_END
DELAY:500
# SECTION:@c:#ff9900 Check: In Area 6
SET_VARIABLE:{"name":"a6Diff","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1312},"y1":{"lit":600},"x2":{"lit":1537},"y2":{"lit":787}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(194,205,213,255)"}}}}
SET_VARIABLE:{"name":"a6Alt","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1312},"y1":{"lit":600},"x2":{"lit":1537},"y2":{"lit":787}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(210,217,219,255)"}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"a6Alt"},"b":{"get":"a6Diff"}}}}
SET_VARIABLE:{"name":"a6Diff","value":{"get":"a6Alt"}}
END_IF
REPEAT:30
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"a6Diff"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_a6","value":{"lit":1}}
BREAK_LOOP
END_IF
DELAY:100
SET_VARIABLE:{"name":"a6Diff","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1312},"y1":{"lit":600},"x2":{"lit":1537},"y2":{"lit":787}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(194,205,213,255)"}}}}
SET_VARIABLE:{"name":"a6Alt","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1312},"y1":{"lit":600},"x2":{"lit":1537},"y2":{"lit":787}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(210,217,219,255)"}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"a6Alt"},"b":{"get":"a6Diff"}}}}
SET_VARIABLE:{"name":"a6Diff","value":{"get":"a6Alt"}}
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_a6"},"b":{"lit":1}}}}
LOG:[base_to_meteor] gate-a6 OK - area 6 view is on screen (box diff=${a6Diff} need<=0.25 best of default rgba(194,205,213) / high rgba(210,217,219) high=${a6Alt})
END_IF
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_a6"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate-a6: area 6 never drew in 3.0s (box diff=${a6Diff} need<=0.25 best of default rgba(194,205,213) / high rgba(210,217,219) high=${a6Alt}) - not pressing F4
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
SET_VARIABLE:{"name":"retry_a6","value":{"arith":{"op":"+","a":{"get":"retry_a6"},"b":{"lit":1}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"retry_a6"},"b":{"lit":3}}}}
LOG:[base_to_meteor] restarting: base teleport, then the whole macro again
SET_VARIABLE:{"name":"wantRestart","value":{"lit":1}}
END_IF
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"retry_a6"},"b":{"lit":3}}}}
LOG:[base_to_meteor] a6 restart budget spent - base teleport and end this run
END_IF
GOTO:BACK_TO_BASE
END_IF
# SECTION_END
# After the area 6 rift the teleport is on cooldown. 500ms was still
# too soon (menu opened, click went through, the character never moved).
DELAY:700
LABEL:TELEPORT_A5
SET_VARIABLE:{"name":"gate_tp5","value":{"lit":0}}
SET_VARIABLE:{"name":"gate_panel5","value":{"lit":0}}
SET_VARIABLE:{"name":"gate_load5","value":{"lit":0}}
SET_VARIABLE:{"name":"mapDifference","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":947},"y1":{"lit":319},"x2":{"lit":1054},"y2":{"lit":418}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(20,35,66,255)"}}}}
SET_VARIABLE:{"name":"a5Def","value":{"get":"mapDifference"}}
SET_VARIABLE:{"name":"a5Alt","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":947},"y1":{"lit":319},"x2":{"lit":1054},"y2":{"lit":418}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(30,34,66,255)"}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"a5Alt"},"b":{"get":"mapDifference"}}}}
SET_VARIABLE:{"name":"mapDifference","value":{"get":"a5Alt"}}
END_IF
# SECTION:Teleport: Area 5
KEY_PRESS:73
DELAY:100
REPEAT:25
DELAY:100
SET_VARIABLE:{"name":"closeButtonDifference","value":{"color_diff":{"a":{"lit":"rgba(247,255,26,255)"},"b":{"screen_color":{"x":1000,"y":914}}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"closeButtonDifference"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_tp5","value":{"lit":1}}
BREAK_LOOP
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_tp5"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate1 tp-menu-area5: yellow close button NOT at (1000,914) after 5 tries diff=${closeButtonDifference} need<=0.25 - clicking 995,831 blind
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
DELAY:0
MOUSE_MOVE_ABS:995,831
DELAY:50
MOUSE_LEFT_CLICK
DELAY:100
REPEAT:5
DELAY:100
SET_VARIABLE:{"name":"panelBgColorDifference","value":{"color_diff":{"a":{"lit":"rgba(28,34,39,255)"},"b":{"screen_color":{"x":694,"y":800}}}}}
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"panelBgColorDifference"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_panel5","value":{"lit":1}}
BREAK_LOOP
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_panel5"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate2 panel-area5: destination panel NOT at (694,800) after 5 tries diff=${panelBgColorDifference} need>=0.25 - clicking 972,465 blind
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
DELAY:0
MOUSE_MOVE_ABS:972,465
DELAY:50
MOUSE_LEFT_CLICK
DELAY:100
# SECTION_END
DELAY:350
# SECTION:@c:#ff9900 Wait: Load Area 5
# Match <=0.40 against the closer of the two rock colors
# (default rgba(20,35,66), high graphics rgba(30,34,66)).
# A dead teleport stays near 0.46 and never moves — retry that at 1.2s
# instead of sitting the full 2.5s. A picture that is still changing
# keeps waiting.
SET_VARIABLE:{"name":"a5Poll","value":{"lit":0}}
SET_VARIABLE:{"name":"a5First","value":{"lit":-1}}
REPEAT:25
DELAY:100
SET_VARIABLE:{"name":"mapDifference","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":947},"y1":{"lit":319},"x2":{"lit":1054},"y2":{"lit":418}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(20,35,66,255)"}}}}
SET_VARIABLE:{"name":"a5Def","value":{"get":"mapDifference"}}
SET_VARIABLE:{"name":"a5Alt","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":947},"y1":{"lit":319},"x2":{"lit":1054},"y2":{"lit":418}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(30,34,66,255)"}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"a5Alt"},"b":{"get":"mapDifference"}}}}
SET_VARIABLE:{"name":"mapDifference","value":{"get":"a5Alt"}}
END_IF
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"mapDifference"},"b":{"lit":0.4}}}}
SET_VARIABLE:{"name":"gate_load5","value":{"lit":1}}
LOG:Detected!
BREAK_LOOP
END_IF
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"a5First"},"b":{"lit":0}}}}
SET_VARIABLE:{"name":"a5First","value":{"get":"mapDifference"}}
END_IF
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"a5First"},"b":{"lit":0}}}}
SET_VARIABLE:{"name":"a5Poll","value":{"arith":{"op":"+","a":{"get":"a5Poll"},"b":{"lit":1}}}}
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"a5Poll"},"b":{"lit":12}}}}
IF:{"expr":{"cmp":{"op":"GT","a":{"get":"mapDifference"},"b":{"lit":0.32}}}}
SET_VARIABLE:{"name":"a5Hi","value":{"arith":{"op":"+","a":{"get":"a5First"},"b":{"lit":0.04}}}}
SET_VARIABLE:{"name":"a5Lo","value":{"arith":{"op":"+","a":{"get":"mapDifference"},"b":{"lit":0.04}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"mapDifference"},"b":{"get":"a5Hi"}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"a5First"},"b":{"get":"a5Lo"}}}}
LOG:[base_to_meteor] a5 view frozen at diff=${mapDifference} after 1.2s — teleport did not take, retrying
BREAK_LOOP
END_IF
END_IF
END_IF
END_IF
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_load5"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate3 load-area5: a5 rock box never matched diff=${mapDifference} need<=0.40 best of default rgba(20,35,66) / high rgba(30,34,66) default=${a5Def} high=${a5Alt} - walking now would click the wrong ground
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
SET_VARIABLE:{"name":"a5Diff","value":{"get":"mapDifference"}}
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_load5"},"b":{"lit":0}}}}
SET_VARIABLE:{"name":"retry_a5","value":{"arith":{"op":"+","a":{"get":"retry_a5"},"b":{"lit":1}}}}
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_a6"},"b":{"lit":1}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"retry_a5"},"b":{"lit":4}}}}
LOG:[base_to_meteor] a5 retry - a6 still on screen, redoing only the a5 teleport
SET_VARIABLE:{"name":"wantRestart","value":{"lit":0}}
GOTO:TELEPORT_A5
END_IF
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"retry_a5"},"b":{"lit":4}}}}
LOG:[base_to_meteor] a5 retry budget spent - base teleport and end this run
GOTO:BACK_TO_BASE
END_IF
END_IF
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_a6"},"b":{"lit":0}}}}
LOG:[base_to_meteor] a5 missed AND a6 is not loaded - restarting the whole macro
SET_VARIABLE:{"name":"retry_a6","value":{"arith":{"op":"+","a":{"get":"retry_a6"},"b":{"lit":1}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"retry_a6"},"b":{"lit":3}}}}
SET_VARIABLE:{"name":"wantRestart","value":{"lit":1}}
END_IF
GOTO:BACK_TO_BASE
END_IF
END_IF
DELAY:0
# SECTION_END
DELAY:500
# SECTION:Walk: Meteor
SMOOTH_MOVE:900,4
KEY_DOWN:57
KEY_PRESS:10
DELAY:900
SMOOTH_MOVE:950,11
DELAY:500
