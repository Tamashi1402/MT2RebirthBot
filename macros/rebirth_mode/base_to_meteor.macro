DELAY:50
MOUSE_LEFT_DOWN
DELAY:300
MOUSE_LEFT_UP
LOG:[base_to_meteor] meteor hit sent (300ms LMB hold - no in-macro verification)
# SECTION_END
DELAY:300
LABEL:BACK_TO_BASE
# SECTION:Teleport: Base
KEY_PRESS:73
DELAY:100
REPEAT:5
DELAY:100
SET_VARIABLE:{"name":"closeButtonDifference","value":{"color_diff":{"a":{"lit":"rgba(247,255,26,255)"},"b":{"screen_color":{"x":1000,"y":914}}}}}
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"closeButtonDifference"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_tpb","value":{"lit":1}}
BREAK_LOOP
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_tpb"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate4 tp-menu-base: yellow close button NOT at (1000,914) after 5 tries diff=${closeButtonDifference} need<=0.25 - clicking 995,831 blind
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
DELAY:0
SET_VARIABLE:{"name":"panelBeforeColor","value":{"screen_color":{"x":694,"y":800}}}
MOUSE_MOVE_ABS:995,831
DELAY:50
MOUSE_LEFT_CLICK
REPEAT:12
DELAY:150
SET_VARIABLE:{"name":"panelBgColorDifference","value":{"color_diff":{"a":{"lit":"rgba(28,34,39,255)"},"b":{"screen_color":{"x":694,"y":800}}}}}
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"panelBgColorDifference"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_panelb","value":{"lit":1}}
BREAK_LOOP
END_IF
SET_VARIABLE:{"name":"panelChangeDiff","value":{"color_diff":{"a":{"get":"panelBeforeColor"},"b":{"screen_color":{"x":694,"y":800}}}}}
IF:{"expr":{"cmp":{"op":"GTE","a":{"get":"panelChangeDiff"},"b":{"lit":0.1}}}}
SET_VARIABLE:{"name":"gate_panelb","value":{"lit":1}}
BREAK_LOOP
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_panelb"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate5 panel-base: base destination panel never drew at (694,800) in 1.8s (bg diff=${panelBgColorDifference} change=${panelChangeDiff}) - clicking 972,909 blind
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
DELAY:0
MOUSE_MOVE_ABS:972,909
DELAY:50
MOUSE_LEFT_CLICK
# SECTION_END
DELAY:250
# SECTION:@c:#ff9900 Wait: Load Base
REPEAT:18
DELAY:100
SET_VARIABLE:{"name":"mapDifference","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1467},"y1":{"lit":44},"x2":{"lit":1542},"y2":{"lit":123}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(14,50,111,255)"}}}}
SET_VARIABLE:{"name":"baseDef","value":{"get":"mapDifference"}}
SET_VARIABLE:{"name":"baseAlt","value":{"color_diff":{"a":{"color_avg":{"a":{"hue_list":{"box":{"res_scale":{"a":{"box":{"x1":{"lit":1467},"y1":{"lit":44},"x2":{"lit":1542},"y2":{"lit":123}}},"spec":{"res_spec":{"rw":{"lit":16},"rh":{"lit":9},"dw":{"lit":1920},"dh":{"lit":1080}}}}}}}}},"b":{"lit":"rgba(8,4,2,255)"}}}}
IF:{"expr":{"cmp":{"op":"LT","a":{"get":"baseAlt"},"b":{"get":"mapDifference"}}}}
SET_VARIABLE:{"name":"mapDifference","value":{"get":"baseAlt"}}
END_IF
IF:{"expr":{"cmp":{"op":"LTE","a":{"get":"mapDifference"},"b":{"lit":0.25}}}}
SET_VARIABLE:{"name":"gate_loadb","value":{"lit":1}}
BREAK_LOOP
END_IF
ENDREPEAT
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"gate_loadb"},"b":{"lit":0}}}}
LOG:[base_to_meteor] FAIL gate6 load-base: Base load check never matched in 1.8s diff=${mapDifference} need<=0.25 best of default rgba(14,50,111) / high rgba(8,4,2) default=${baseDef} high=${baseAlt} - bot still assumes it is at base
SET_VARIABLE:{"name":"failCount","value":{"arith":{"op":"+","a":{"get":"failCount"},"b":{"lit":1}}}}
END_IF
IF:{"expr":{"cmp":{"op":"EQ","a":{"get":"wantRestart"},"b":{"lit":1}}}}
SET_VARIABLE:{"name":"wantRestart","value":{"lit":0}}
GOTO:MACRO_START
END_IF
DELAY:0
# SECTION_END
LOG:[base_to_meteor] SUMMARY fail=${failCount} a6=${gate_a6}(${a6Diff}) a5=${gate_load5}(${a5Diff}) tp5=${gate_tp5} panel5=${gate_panel5} tpb=${gate_tpb} panelb=${gate_panelb} loadb=${gate_loadb} retry_a6=${retry_a6} retry_a5=${retry_a5} (1=ok 0=missed)
LOCK_END:
