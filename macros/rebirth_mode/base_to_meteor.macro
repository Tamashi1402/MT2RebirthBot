VARIABLE:{"name":"gate_tpb","var_type":"number","value":0}
VARIABLE:{"name":"gate_panelb","var_type":"number","value":0}
VARIABLE:{"name":"gate_loadb","var_type":"number","value":0}
VARIABLE:{"name":"panelChangeDiff","var_type":"number","value":0}
VARIABLE:{"name":"panelBeforeColor","var_type":"color","value":""}
VARIABLE:{"name":"gate_a6","var_type":"number","value":0}
VARIABLE:{"name":"a6Diff","var_type":"number","value":0}
VARIABLE:{"name":"a6Alt","var_type":"number","value":0}
VARIABLE:{"name":"a5Def","var_type":"number","value":0}
VARIABLE:{"name":"a5Alt","var_type":"number","value":0}
